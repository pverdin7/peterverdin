{
  "name": "peter-verdin-portfolio",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "description": "Approved narrative portfolio with public career evidence and server-authorized case studies and view-only samples.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "node scripts/check-build.mjs",
    "build": "npm run check",
    "preview": "python3 -m http.server 8080 --directory public",
    "dev": "wrangler pages dev public --local-protocol=https",
    "deploy": "wrangler pages deploy public --project-name=peter-verdin --branch main",
    "test": "node --test tests/*.test.mjs",
    "assets:check": "node scripts/private-assets.mjs check",
    "assets:sync": "node scripts/private-assets.mjs sync",
    "assets:upload": "node scripts/private-assets.mjs upload",
    "config:check": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  }
}
